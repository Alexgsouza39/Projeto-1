# Configurações de Ambiente - Exemplo
# ====================================
# Copie este arquivo para .env e preenchao seus valores
# Não commite .env no repositório (adicione ao .gitignore)

# Chave secreta para criptografia de sessão e CSRF
# Regenere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# URI de banco de dados
# SQLite: sqlite:///site.db
# PostgreSQL: postgresql://user:password@localhost/dbname
# MySQL: mysql+pymysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///site.db

# Modo de ambiente (development, production, testing)
FLASK_ENV=development

# Debug mode (False em produção)
FLASK_DEBUG=False

# Host e porta
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
